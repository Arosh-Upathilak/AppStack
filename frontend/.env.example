# --- Core ---
# Local dev uses SQLite (no external DB required). For prod, switch to Postgres
# and update prisma/schema.prisma `datasource` accordingly.
DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js v5)
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="please-change-me-to-a-random-32-byte-string"
AUTH_URL="http://localhost:3000"

# --- Stripe (Phase 2 onward) ---
# Without real keys the app falls back to a simulated adapter that just logs.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Resend (email) ---
# Without RESEND_API_KEY the email adapter logs to console.
RESEND_API_KEY=""
EMAIL_FROM="AppStack <noreply@example.com>"

# --- reCAPTCHA v3 (NRQ-9) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Inngest (Phase 8) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Pixels (NRQ-4) ---
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Set to "1" to bypass auth middleware in development (useful while seeding UI work)
AUTH_BYPASS="0"
