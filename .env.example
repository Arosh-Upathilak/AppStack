# AppStack Environment Variables
#
# Copy this file to `.env` at the repo root: `cp .env.example .env`
# docker-compose reads it automatically. Every value below has a safe demo
# default baked into docker-compose.yml, so `docker compose up --build` works
# with NO .env at all (demo on the seeded accounts). Fill the OPTIONAL blocks
# only to unlock the register→OTP email flow, Google sign-in, or live reCAPTCHA.

# ── Core (have working demo defaults) ───────────────────────────────────────
JWT_SECRET="demo_super_secret_jwt_key_123"            # must match FE & BE
NEXTAUTH_SECRET="nextauth_demo_secret_key_987"

# ── OPTIONAL: Email (register → OTP). Use a Gmail App Password, not your login.
# Leave blank to demo on seeded accounts (no email is sent).
EMAIL_USER=""
EMAIL_PASSWORD=""

# ── OPTIONAL: reCAPTCHA v3. Leave blank to skip bot-check in dev/demo.
# Both must be set together (site key = frontend, secret = backend).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ── OPTIONAL: Google sign-in. Register the redirect URI in Google Cloud:
#   http://localhost:3000/api/auth/callback/google
NEXT_GOOGLE_CLIENT_ID=""
NEXT_GOOGLE_CLIENT_SECRET=""

# ── Non-Docker (local `npm run dev`) reference values ───────────────────────
# Docker injects these itself; only needed when running outside compose.
# PORT=5001
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appstack?schema=public"
# REDIS_URL="redis://localhost:6379"
# FRONTEND_URL="http://localhost:3000"
# NEXTAUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_API_BASE_URL="http://localhost:5001/api"
# NEXT_PUBLIC_API_SOCKET_BASE_URL="http://localhost:5001"
